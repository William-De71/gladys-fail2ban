      },
      {
        "key": "username",
        "type": "string"
      },
      {
        "key": "auth_method",
        "type": "select"
      },
      {
        "key": "password",
        "type": "secret"
      },
      {
        "key": "key_help",
        "type": "section"
      },
      {
        "key": "command",
        "type": "string"
