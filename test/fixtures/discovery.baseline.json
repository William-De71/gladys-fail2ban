{
  "devices": {
    "server": {
      "external_id": "ext:fail2ban:server:main",
      "should_poll": false,
      "params": ["FAIL2BAN_HOST"],
      "features": [
        {
          "external_id": "ext:fail2ban:server:main:banned",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 1000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:fail2ban:server:main:failed",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 1000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:fail2ban:server:main:total_banned",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 1000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:fail2ban:server:main:jails",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 1000,
          "read_only": true,
          "has_feedback": false
        }
      ]
    },
    "jail": {
      "external_id": "ext:fail2ban:jail:nginx-http-auth",
      "should_poll": false,
      "params": ["FAIL2BAN_JAIL", "FAIL2BAN_LOGS"],
      "features": [
        {
          "external_id": "ext:fail2ban:jail:nginx-http-auth:banned",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 1000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:fail2ban:jail:nginx-http-auth:failed",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 1000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:fail2ban:jail:nginx-http-auth:total_banned",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 1000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:fail2ban:jail:nginx-http-auth:total_failed",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 1000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:fail2ban:jail:nginx-http-auth:last_banned",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        }
      ]
    }
  },
  "manifest": {
